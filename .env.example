# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# JAKARTA RUSH HOUR - VPS DEPLOYMENT CONFIGURATION
# ==============================================================================
# The app is published on 127.0.0.1:6100 only (Nginx reverse proxy reaches it)
# Database is internal only (no ports exposed to the host/internet)

POSTGRES_USER=jakarta_user
POSTGRES_PASSWORD=change_this_secret_password_here
POSTGRES_DB=jakarta_rush_db
